{
  "name": "tank-malle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "npx --no-install firebase emulators:start --only auth,firestore",
    "test:rules": "npx --no-install firebase emulators:exec --only firestore --project tank-maleh-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test --project=pwa",
    "test:e2e:ui": "playwright test --ui",
    "dev:care": "vite --mode care --host 127.0.0.1 --port 5283 --strictPort",
    "emulators:care": "firebase emulators:start --only auth,firestore --project demo-tankmaleh --config firebase.care-local.json",
    "test:care": "playwright test --config playwright.care.config.ts",
    "test:care:pwa": "playwright test --config playwright.care-pwa.config.ts",
    "dev:care:device": "node scripts/care-device.mjs",
    "test:unified": "playwright test --config playwright.unified.config.ts",
    "native:prepare": "node scripts/prepare-native.mjs",
    "native:android": "node scripts/build-android.mjs",
    "native:icons": "node scripts/generate-app-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capgo/capacitor-printer": "8.1.10",
    "@capgo/capacitor-social-login": "8.7.9",
    "firebase": "^11.10.0",
    "pdfjs-dist": "6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "^6.2.5",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.28.2",
    "oxlint": "^1.79.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "firebase-tools": {
      "chokidar": "^4.0.3"
    },
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "^2.8.0"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
