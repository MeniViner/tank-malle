# E2E-only configuration. Emulator values, never a real project.
#
# "demo-" project ids are special-cased by the Firebase emulators: they refuse
# to reach any real Google service, so a misconfigured test cannot touch
# production. The API key is a placeholder the emulator never validates.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tankmaleh.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-tankmaleh
VITE_FIREBASE_STORAGE_BUCKET=demo-tankmaleh.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_EMULATORS=1
