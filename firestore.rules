rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Granted as a custom claim by scripts/grantAdmin.mjs. Claims are signed
    // by Firebase, so this cannot be spoofed from the client.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // `math.isInfinite` does not exist in the rules language, so infinity is
    // excluded with an explicit bound instead.
    function isNumber(value) {
      return value is number
        && !math.isNaN(value)
        && value > -9999999999
        && value < 9999999999;
    }

    // Epoch milliseconds do not fit isNumber's bound — 1.7e12 is far above the
    // 1e10 ceiling that keeps odometers and prices sane. Timestamps get their
    // own predicate rather than a loosened shared one.
    function isEpochMillis(value) {
      return value is number
        && !math.isNaN(value)
        && value > 0
        && value < 4102444800000;  // 2100-01-01
    }

    function optionalEpochMillis(data, field) {
      return !(field in data) || data[field] == null || isEpochMillis(data[field]);
    }

    function isString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function optionalString(data, field, maxLength) {
      return !(field in data) || data[field] == null || isString(data[field], maxLength);
    }

    function optionalNumber(data, field) {
      return !(field in data) || data[field] == null || isNumber(data[field]);
    }

    function optionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    // A station reference. stationId is the stable identity; the rest are
    // snapshots taken at the time of the fill-up.
    function validStation(station) {
      return station.keys().hasOnly(['name', 'lat', 'lng', 'stationId', 'brand'])
        && isString(station.name, 120)
        && optionalNumber(station, 'lat')
        && optionalNumber(station, 'lng')
        && optionalString(station, 'stationId', 64)
        && optionalString(station, 'brand', 60);
    }

    // Only raw fill-up data is ever stored — no derived fields to validate.
    // A strict field whitelist: an unrecognised key is rejected rather than
    // silently persisted, so a compromised client cannot smuggle arbitrary
    // nested data into a user's records.
    function validFillup(data) {
      return data.keys().hasOnly([
             'date', 'odometer', 'liters', 'pricePerLiter', 'totalCost',
             'isFullTank', 'station', 'notes', 'createdAt',
             'continuityBreakBefore', 'fullTankSource', 'postedPricePerLiter',
             'fuelType', 'importSource', 'importBatchId', 'importRowHash',
             'schemaVersion'
           ])
        && isNumber(data.odometer) && data.odometer > 0 && data.odometer < 3000000
        && isNumber(data.liters) && data.liters > 0 && data.liters <= 500
        && isNumber(data.pricePerLiter) && data.pricePerLiter >= 0 && data.pricePerLiter <= 100
        && isNumber(data.totalCost) && data.totalCost >= 0 && data.totalCost <= 50000
        && data.isFullTank is bool
        && data.date is timestamp
        // Liters x paid price should reconcile with the total. pricePerLiter is
        // the price actually PAID, so a discount is already inside it and only
        // pump rounding and small manual edits need room. The tolerance is the
        // larger of 5 shekels and 5%, so the check stays meaningful on a small
        // fill-up without rejecting a large legitimate one. A zero total is
        // left alone rather than forced to reconcile.
        && (data.totalCost == 0
            || (data.totalCost <= data.liters * data.pricePerLiter + 5
                  + data.liters * data.pricePerLiter * 0.05
                && data.totalCost >= data.liters * data.pricePerLiter - 5
                  - data.liters * data.pricePerLiter * 0.05))
        && optionalBool(data, 'continuityBreakBefore')
        && (!('fullTankSource' in data)
            || data.fullTankSource in ['user', 'legacy-assumption'])
        && (!('postedPricePerLiter' in data) || data.postedPricePerLiter == null
            || (isNumber(data.postedPricePerLiter)
                && data.postedPricePerLiter >= 0 && data.postedPricePerLiter <= 100))
        && (!('fuelType' in data) || data.fuelType == null
            || data.fuelType in ['95', '98', 'diesel', 'other'])
        && optionalString(data, 'importSource', 60)
        && optionalString(data, 'importBatchId', 64)
        && optionalString(data, 'importRowHash', 64)
        && optionalNumber(data, 'schemaVersion')
        && optionalString(data, 'notes', 500)
        && (!('station' in data) || data.station == null || validStation(data.station));
    }

    function validVehicle(data) {
      return data.make is string && data.make.size() > 0 && data.make.size() <= 60
        && data.model is string && data.model.size() <= 80
        && data.fuelType in ['95', '98', 'diesel', 'other']
        && data.archived is bool
        && isNumber(data.priceAdjustment)
        && (!('tankLiters' in data) || data.tankLiters == null
            || (isNumber(data.tankLiters) && data.tankLiters > 0))
        && (!('tankLitersSource' in data) || data.tankLitersSource == null
            || data.tankLitersSource in ['user', 'trusted', 'estimate', 'legacy'])
        && (!('declaredKmPerLiter' in data) || data.declaredKmPerLiter == null
            || (isNumber(data.declaredKmPerLiter) && data.declaredKmPerLiter > 0))
        && (!('declaredSource' in data) || data.declaredSource == null
            || data.declaredSource in ['user', 'exact-year', 'other-year'])
        && (!('manualPricePerLiter' in data) || data.manualPricePerLiter == null
            || (isNumber(data.manualPricePerLiter) && data.manualPricePerLiter >= 0))
        && (!('year' in data) || data.year == null
            || (isNumber(data.year) && data.year >= 1900 && data.year <= 2100))
        && (!('tozeretCd' in data) || data.tozeretCd == null || isNumber(data.tozeretCd))
        && (!('degemCd' in data) || data.degemCd == null || isNumber(data.degemCd))
        && (!('plateNumber' in data) || data.plateNumber == null
            || (data.plateNumber is string && data.plateNumber.size() <= 12))
        && (!('nickname' in data) || data.nickname == null
            || (data.nickname is string && data.nickname.size() <= 60));
    }

    // An anonymous economy summary. Deliberately narrow: anything that could
    // identify a person or a place is rejected outright, so a compromised
    // client cannot turn this collection into a tracking log.
    function validBenchmark(data) {
      return data.keys().hasOnly([
             'vehicleId', 'modelKey', 'fuelType', 'year', 'avgKmPerLiter',
             'segments', 'avgPricePerLiter', 'updatedAt'
           ])
        && (!('vehicleId' in data) || isString(data.vehicleId, 64))
        && data.modelKey is string && data.modelKey.size() <= 80
        && data.fuelType in ['95', '98', 'diesel', 'other']
        && isNumber(data.avgKmPerLiter)
        && data.avgKmPerLiter > 0 && data.avgKmPerLiter < 100
        && isNumber(data.segments) && data.segments >= 0
        && (data.year == null
            || (isNumber(data.year) && data.year >= 1900 && data.year <= 2100))
        && (data.avgPricePerLiter == null
            || (isNumber(data.avgPricePerLiter) && data.avgPricePerLiter >= 0));
    }

    match /users/{uid} {
      // Admins read the PROFILE only — display name, email, join date — which
      // the dashboard needs to list accounts and support needs to find one.
      // Vehicles and fill-ups below are owner-only, with no admin exception.
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && (!('settings' in request.resource.data) || request.resource.data.settings is map)
        // Login stamps, rotated once per authentication event. Numbers only,
        // so a client cannot stash arbitrary structures on the profile.
        && optionalEpochMillis(request.resource.data, 'previousLoginAt')
        && optionalEpochMillis(request.resource.data, 'currentLoginAt')
        && optionalEpochMillis(request.resource.data, 'lastProcessedAuthTime');
      allow delete: if isOwner(uid);

      /**
       * Raw community price reports.
       *
       * Owner-only, in both directions. A raw observation is tied to one person
       * and one place at one time, so it never becomes readable by other signed
       * -in users; only the backend-produced aggregate is public.
       */
      match /stationPriceReports/{reportId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validPriceReport(request.resource.data);
        // A report is an observation, not a document to revise.
        allow update: if false;
      }

      /**
       * Import batch records.
       *
       * These exist so an import stays reversible: every record an import
       * created carries the batch id, and deleting the batch removes exactly
       * those rows and nothing a person entered by hand.
       */
      /**
       * Explicit personal pricing rules.
       *
       * Private in both directions: a discount someone negotiated is theirs,
       * and it must never leak into a public station price. `legacy` marks a
       * rule carried over from the pre-upgrade vehicle fields; it does nothing
       * until `reviewed` is true.
       */
      match /personalPriceRules/{ruleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'vehicleId', 'stationId', 'stationName', 'fuelType',
               'discountPerLiter', 'fixedPricePerLiter', 'label',
               'expiresAt', 'legacy', 'reviewed', 'migratedAt'
             ])
          && optionalString(request.resource.data, 'vehicleId', 64)
          && optionalString(request.resource.data, 'stationId', 64)
          && optionalString(request.resource.data, 'stationName', 120)
          && optionalString(request.resource.data, 'label', 80)
          && (!('fuelType' in request.resource.data)
              || request.resource.data.fuelType == null
              || request.resource.data.fuelType in ['95', '98', 'diesel', 'other'])
          && isNumber(request.resource.data.discountPerLiter)
          && request.resource.data.discountPerLiter > -50
          && request.resource.data.discountPerLiter < 50
          && (!('fixedPricePerLiter' in request.resource.data)
              || request.resource.data.fixedPricePerLiter == null
              || (isNumber(request.resource.data.fixedPricePerLiter)
                  && request.resource.data.fixedPricePerLiter >= 0
                  && request.resource.data.fixedPricePerLiter < 100))
          && optionalEpochMillis(request.resource.data, 'expiresAt')
          && optionalBool(request.resource.data, 'legacy')
          && optionalBool(request.resource.data, 'reviewed');
      }

      match /importBatches/{batchId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'vehicleId', 'format', 'fileName', 'recordCount',
               'vehicleLabel', 'importedAt'
             ])
          && isString(request.resource.data.vehicleId, 64)
          && isString(request.resource.data.format, 40)
          && optionalString(request.resource.data, 'fileName', 200)
          && optionalString(request.resource.data, 'vehicleLabel', 120)
          && isNumber(request.resource.data.recordCount)
          && request.resource.data.recordCount >= 0
          && request.resource.data.recordCount <= 100000;
      }

      /**
       * Vehicles and fill-ups are OWNER-ONLY.
       *
       * Admins used to have read here, for a dashboard that counted records by
       * reading them. It now reads published summaries instead, so the
       * permission had no remaining purpose — and a permission with no purpose
       * is one that should not exist.
       */
      match /vehicles/{vehicleId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validVehicle(request.resource.data);

        match /fillups/{fillupId} {
          allow read: if isOwner(uid);
          allow delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validFillup(request.resource.data);
        }
      }
    }

    /**
     * A price observation. Plausibility is bounded per fuel type: a report far
     * outside the range that fuel has ever traded at in Israel is a typo or an
     * attack, and either way must not reach the aggregate.
     */
    function validPriceReport(data) {
      return data.keys().hasOnly([
             'stationId', 'fuelType', 'serviceMode', 'postedPrice', 'paidPrice',
             'hadPersonalDiscount', 'observedAt', 'createdAt',
             'locationConfidence', 'reportSource', 'appVersion', 'status'
           ])
        && isString(data.stationId, 64) && data.stationId.size() > 0
        && data.fuelType in ['95', '98', 'diesel', 'other']
        && (!('serviceMode' in data) || data.serviceMode in ['self', 'full'])
        && isNumber(data.postedPrice)
        && data.postedPrice > 1 && data.postedPrice < 30
        && (!('paidPrice' in data) || data.paidPrice == null
            || (isNumber(data.paidPrice) && data.paidPrice > 0 && data.paidPrice < 30))
        && optionalBool(data, 'hadPersonalDiscount')
        && data.observedAt is timestamp
        && (!('locationConfidence' in data)
            || data.locationConfidence in ['verified', 'nearby', 'manual'])
        && optionalString(data, 'reportSource', 40)
        && optionalString(data, 'appVersion', 20)
        && (!('status' in data) || data.status in ['pending', 'accepted', 'rejected']);
    }

    /**
     * Operational summaries, published by each client for the admin dashboard.
     *
     * Counts and averages only: no dates beyond the last fill-up, no odometer
     * readings, no stations, no notes, no per-record prices. This is what lets
     * the dashboard stop reading anybody's fuel log.
     *
     * They are CLIENT-PRODUCED and back no security decision — a modified
     * client can write whatever it likes about itself. The bounds below exist
     * so a hostile value cannot break the dashboard, not so the numbers can be
     * trusted for anything that matters.
     */
    function validSummary(data) {
      return data.keys().hasOnly(['version', 'vehicleCount', 'vehicles', 'updatedAt'])
        && isNumber(data.version)
        && isNumber(data.vehicleCount)
        && data.vehicleCount >= 0 && data.vehicleCount <= 100
        && data.vehicles is map
        && data.vehicles.keys().size() <= 100;
    }

    match /userSummaries/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && validSummary(request.resource.data);
      allow delete: if isOwner(uid) || isAdmin();
    }

    /**
     * Public station-price aggregates.
     *
     * Readable by any signed-in user, writable ONLY by trusted backend code,
     * which bypasses rules. A client therefore cannot forge a confidence level,
     * a report count or a reporter total to make a fabricated price look
     * corroborated. Until the aggregator is deployed (Blaze), this collection
     * is simply empty and the UI says the data is unavailable.
     */
    match /stationPriceAggregates/{aggregateId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /**
     * Community benchmarks, one document PER VEHICLE.
     *
     * The id is "{uid}__{vehicleId}", so ownership is provable without a
     * backend while a two-car household no longer has one vehicle overwrite
     * the other. The bare "{uid}" form is still accepted so pre-upgrade
     * documents remain writable and deletable by their owner.
     *
     * Note that the uid appears in a world-readable document id. That makes
     * this pool PSEUDONYMOUS, not anonymous, and the documentation says so.
     * True anonymity requires the Blaze-side cohort aggregator.
     */
    function ownsBenchmark(docId) {
      return isSignedIn()
        && (docId == request.auth.uid || docId.matches(request.auth.uid + '__.*'));
    }

    match /benchmarks/{docId} {
      allow read: if isSignedIn();
      allow create, update: if ownsBenchmark(docId) && validBenchmark(request.resource.data);
      allow delete: if ownsBenchmark(docId) || isAdmin();
    }

    // Product feedback. A user may file and read back their own notes; only
    // admins can read the whole pile. Nothing here is ever editable after the
    // fact, so a submission cannot be quietly rewritten.
    function validFeedback(data) {
      return data.keys().hasOnly([
             'uid', 'displayName', 'email', 'message', 'sentiment',
             'appVersion', 'screen', 'createdAt'
           ])
        && data.uid == request.auth.uid
        && data.message is string
        && data.message.size() > 0 && data.message.size() <= 2000
        && (!('sentiment' in data) || data.sentiment == null
            || data.sentiment in ['good', 'idea', 'bug'])
        && (!('displayName' in data) || data.displayName == null
            || (data.displayName is string && data.displayName.size() <= 100))
        && (!('email' in data) || data.email == null
            || (data.email is string && data.email.size() <= 200))
        && (!('appVersion' in data) || data.appVersion == null
            || (data.appVersion is string && data.appVersion.size() <= 20))
        && (!('screen' in data) || data.screen == null
            || (data.screen is string && data.screen.size() <= 60));
    }

    match /feedback/{entryId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && validFeedback(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Global config: readable by any signed-in user; written by the scheduled
    // function, the admin seed script (both bypass rules), or a signed-in admin.
    match /appConfig/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
