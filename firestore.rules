rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function careVehicleWritable(uid, vehicleId) {
      let path = /databases/$(database)/documents/users/$(uid)/vehicles/$(vehicleId);
      return exists(path) && get(path).data.get('deletionPending', false) != true;
    }
    function careInt(value, maximum) { return value is int && value >= 0 && value <= maximum; }
    function careOptionalInt(value, maximum) { return value == null || careInt(value, maximum); }
    function careDay(value) { return value is string && value.matches('^(19|20|21)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function careBase(d) { return d.schemaVersion == 1 && careInt(d.version, 1000000000) && d.version > 0 && isString(d.notes, 2000); }
    function careTitle(d) { return isString(d.title, 120) && d.title.size() > 0; }
    function careIdAt(ids, n) { return ids.size() <= n || (isString(ids[n],64) && ids[n].size() > 0 && !ids[n].matches('.*[/].*')); }
    function validService(d) {
      return d.keys().hasOnly(['schemaVersion','version','day','title','jobs','odometer','costAgorot','garage','notes','completedPlanIds'])
        && careBase(d) && careTitle(d) && careDay(d.day) && careOptionalInt(d.odometer,9999999) && careOptionalInt(d.costAgorot,100000000)
        && isString(d.garage,160) && d.jobs is list && d.jobs.size()>0 && d.jobs.size()<=8
        && d.jobs.hasOnly(['periodic','oil','tires','brakes','battery','repair','custom'])
        && d.completedPlanIds is list && d.completedPlanIds.size()<=8
        && careIdAt(d.completedPlanIds,0) && careIdAt(d.completedPlanIds,1) && careIdAt(d.completedPlanIds,2) && careIdAt(d.completedPlanIds,3)
        && careIdAt(d.completedPlanIds,4) && careIdAt(d.completedPlanIds,5) && careIdAt(d.completedPlanIds,6) && careIdAt(d.completedPlanIds,7);
    }
    function validCarePlan(d) {
      return d.keys().hasOnly(['schemaVersion','version','title','job','dueDay','dueOdometer','intervalMonths','intervalKm','basis','source','notes','active'])
        && careBase(d) && careTitle(d) && d.job in ['periodic','oil','tires','brakes','battery','repair','custom']
        && (d.dueDay == null || careDay(d.dueDay)) && careOptionalInt(d.dueOdometer,9999999) && (d.dueDay != null || d.dueOdometer != null)
        && careOptionalInt(d.intervalMonths,120) && (d.intervalMonths == null || (d.intervalMonths > 0 && d.dueDay != null))
        && careOptionalInt(d.intervalKm,1000000) && (d.intervalKm == null || (d.intervalKm > 0 && d.dueOdometer != null))
        && d.basis in ['completion','fixed','manual'] && d.source in ['manufacturer','garage','owner'] && d.active is bool;
    }
    function validCareExpense(d) {
      // `excluded` ("לכלול בעלות הרכב" switched off) is optional; missing = included.
      return d.keys().hasOnly(['schemaVersion','version','day','category','title','costAgorot','notes','excluded'])
        && careBase(d) && careTitle(d) && careDay(d.day) && careOptionalInt(d.costAgorot,100000000)
        && d.category in ['insurance','registration','parking','toll','wash','other','refund']
        && d.get('excluded', false) is bool;
    }
    function validMileage(d) {
      return d.keys().hasOnly(['schemaVersion','version','day','odometer','notes'])
        && careBase(d) && careDay(d.day) && careInt(d.odometer,9999999);
    }

    function validVehicleIssue(d) {
      let ids = d.serviceEventIds;
      let history = d.history;
      return d.keys().hasOnly(['schemaVersion','version','day','title','symptoms','odometer','importance','status','notes','serviceEventIds','history'])
        && careBase(d) && careTitle(d) && careDay(d.day) && isString(d.symptoms,2000) && careOptionalInt(d.odometer,9999999)
        && d.importance in ['normal','important'] && d.status in ['open','watching','resolved']
        && ids is list && ids.size()<=8
        && careIdAt(ids,0) && careIdAt(ids,1) && careIdAt(ids,2) && careIdAt(ids,3)
        && careIdAt(ids,4) && careIdAt(ids,5) && careIdAt(ids,6) && careIdAt(ids,7)
        && history is list && history.size()<=10
        && (history.size()<=0 || isString(history[0],4096)) && (history.size()<=1 || isString(history[1],4096)) && (history.size()<=2 || isString(history[2],4096)) && (history.size()<=3 || isString(history[3],4096)) && (history.size()<=4 || isString(history[4],4096))
        && (history.size()<=5 || isString(history[5],4096)) && (history.size()<=6 || isString(history[6],4096)) && (history.size()<=7 || isString(history[7],4096))
        && (history.size()<=8 || isString(history[8],4096)) && (history.size()<=9 || isString(history[9],4096));
    }
    function validNotificationState(d) {
      return d.keys().hasOnly(['schemaVersion','version','occurrence','read','archived','snoozeUntilDay','deleted'])
        && d.schemaVersion==1 && careInt(d.version,1000000000) && d.version>0 && isString(d.occurrence,300) && d.occurrence.size()>0
        && d.read is bool && d.archived is bool && (!('deleted' in d) || d.deleted is bool) && (d.snoozeUntilDay==null || careDay(d.snoozeUntilDay));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function accountWritable(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid))
        || get(/databases/$(database)/documents/users/$(uid)).data.get('deletionPending', false) != true;
    }

    // Granted as a custom claim by scripts/grantAdmin.mjs. Claims are signed
    // by Firebase, so this cannot be spoofed from the client.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // `math.isInfinite` does not exist in the rules language, so infinity is
    // excluded with an explicit bound instead.
    function isNumber(value) {
      return value is number
        && !math.isNaN(value)
        && value > -9999999999
        && value < 9999999999;
    }

    // The cheap half of isNumber, for a field that carries its own, tighter
    // bounds: a bound below 1e10 already excludes Infinity, so only the NaN
    // check needs to be explicit. Never use this without a bound.
    function isNonNaNNumber(value) {
      return value is number && !math.isNaN(value);
    }

    // Epoch milliseconds do not fit isNumber's bound — 1.7e12 is far above the
    // 1e10 ceiling that keeps odometers and prices sane. Timestamps get their
    // own predicate rather than a loosened shared one.
    function isEpochMillis(value) {
      return value is number
        && !math.isNaN(value)
        && value > 0
        && value < 4102444800000;  // 2100-01-01
    }

    function optionalEpochMillis(data, field) {
      return !(field in data) || data[field] == null || isEpochMillis(data[field]);
    }

    function isString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // The optional-field helpers read the field ONCE with `data.get(field,
    // null)`: absent and null collapse into the same value, exactly as the
    // former `!(field in data) || data[field] == null` spelling did, at a
    // fraction of the expression count. This matters because Firestore
    // evaluates at most 1,000 expressions per request (see validFillup).
    function stringOrNull(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function numberOrNull(value) {
      return value == null || isNumber(value);
    }

    function optionalString(data, field, maxLength) {
      return stringOrNull(data.get(field, null), maxLength);
    }

    function optionalNumber(data, field) {
      return numberOrNull(data.get(field, null));
    }

    function optionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    // A station reference. stationId is the stable identity; the rest are
    // snapshots taken at the time of the fill-up.
    function validStation(station) {
      return station.keys().hasOnly(['name', 'lat', 'lng', 'stationId', 'brand'])
        && isString(station.name, 120)
        && optionalNumber(station, 'lat')
        && optionalNumber(station, 'lng')
        && optionalString(station, 'stationId', 64)
        && optionalString(station, 'brand', 60);
    }

    // Liters x paid price should reconcile with the total. pricePerLiter is
    // the price actually PAID, so a discount is already inside it and only
    // pump rounding and small manual edits need room. The tolerance is the
    // larger of 5 shekels and 5%, so the check stays meaningful on a small
    // fill-up without rejecting a large legitimate one. A zero total is
    // left alone rather than forced to reconcile.
    //
    // `expected` (liters x price) is computed once by the caller instead of
    // four times inline; each term below is evaluated in the same order as
    // before, so the floating-point result is identical.
    function costReconciles(total, expected) {
      return total == 0
        || (total <= expected + 5 + expected * 0.05
            && total >= expected - 5 - expected * 0.05);
    }

    // Only raw fill-up data is ever stored — no derived fields to validate.
    // A strict field whitelist: an unrecognised key is rejected rather than
    // silently persisted, so a compromised client cannot smuggle arbitrary
    // nested data into a user's records.
    function validFillup(data) {
      return data.keys().hasOnly([
             'date', 'odometer', 'liters', 'pricePerLiter', 'totalCost',
             'isFullTank', 'station', 'notes', 'createdAt',
             'continuityBreakBefore', 'fullTankSource', 'postedPricePerLiter',
             'fuelType', 'importSource', 'importBatchId', 'importRowHash',
             'schemaVersion',
             // Optional tank-state measurements. Added to the existing
             // whitelist rather than relaxing it: an unrecognised key is still
             // rejected outright.
             'fillEndState', 'fillEndStateSource',
             'preFillLevel', 'preFillLevelSource', 'preFillLevelUncertainty',
             'postFillLevel', 'postFillLevelSource', 'postFillLevelUncertainty',
             'refuelReason', 'capacityLitersAtEntry', 'tankSchemaVersion',
             // Optimistic-concurrency stamp. Its VALUE is checked on the
             // fill-up allow lines (versionOk on create, stored + 1 on
             // update), not here, to keep the shared path cheap.
             'version',
             // Per-write marker stamped by clients that also stamp `version`.
             // Its CHANGE is what tells a version-aware write from a legacy
             // patch on the update line below.
             'writeId'
           ])
        // Each bound here is tighter than isNumber's ±1e10, so the cheaper
        // NaN-only predicate gives the same accepted set (Infinity fails the
        // upper bound). See the expression-budget note above validTankFields.
        && isNonNaNNumber(data.odometer) && data.odometer > 0 && data.odometer < 3000000
        && isNonNaNNumber(data.liters) && data.liters > 0 && data.liters <= 500
        && isNonNaNNumber(data.pricePerLiter) && data.pricePerLiter >= 0 && data.pricePerLiter <= 100
        && isNonNaNNumber(data.totalCost) && data.totalCost >= 0 && data.totalCost <= 50000
        && data.isFullTank is bool
        && data.date is timestamp
        && costReconciles(data.totalCost, data.liters * data.pricePerLiter)
        && optionalBool(data, 'continuityBreakBefore')
        && (!('fullTankSource' in data)
            || data.fullTankSource in ['user', 'legacy-assumption'])
        // `data.get(field, null) == null` is the cheap spelling of "absent or
        // null" — see the expression-budget note above validTankFields.
        // (fullTankSource above keeps its `in data` form on purpose: it
        // rejects an explicit null, which `get(field, null)` cannot see.)
        && (data.get('postedPricePerLiter', null) == null
            || (isNonNaNNumber(data.postedPricePerLiter)
                && data.postedPricePerLiter >= 0 && data.postedPricePerLiter <= 100))
        && (data.get('fuelType', null) == null
            || data.fuelType in ['95', '98', 'diesel', 'other'])
        && optionalString(data, 'importSource', 60)
        && optionalString(data, 'importBatchId', 64)
        && optionalString(data, 'importRowHash', 64)
        && optionalNumber(data, 'schemaVersion')
        && optionalString(data, 'notes', 500)
        && optionalString(data, 'writeId', 64)
        && (data.get('station', null) == null || validStation(data.station))
        && validTankFields(data);
    }

    // Optimistic-concurrency stamp on a fill-up, CREATE side. ABSENT is fine
    // — an older client never sends it — but once present it must be a real
    // number >= 1 (an explicit null is rejected, like fullTankSource). The
    // upper bound is isNumber's own ceiling, so Infinity is still out.
    //
    // Deliberately not part of validFillup: on update the stamp must equal
    // stored + 1 (see the fill-up `allow update` line), and that equality
    // already forces a well-formed number — the stored value passed this
    // check when it was written, or is absent and counts as 0 — so running
    // the range check again there would only spend expression budget.
    function versionOk(data) {
      return !('version' in data)
        || (isNonNaNNumber(data.version) && data.version >= 1 && data.version < 9999999999);
    }

    // ---------------------------------------------------------------------
    // EXPRESSION BUDGET. Firestore evaluates at most 1,000 expressions per
    // request, and a fully-populated fill-up — station map, before-level,
    // note, import stamps — used to exhaust it inside these helpers. The
    // request then fails PERMISSION_DENIED, the client SDK rolls back its
    // optimistic local write, and the record silently disappears.
    //
    // The helpers below therefore read each optional field ONCE with
    // `data.get(field, null)` (absent and null collapse into one value) and
    // test the VALUE, instead of spelling `field in data`, `data[field]` and
    // a nested `isNumber(...)` call out per field. The accepted set is
    // unchanged: NaN is still rejected explicitly, and every numeric bound
    // below is the one `isNumber` would have imposed (or a tighter one), so
    // ±Infinity is still rejected too. See tests/rules/fillup-budget.test.ts.
    // ---------------------------------------------------------------------

    // A level is a FRACTION of the tank, 0-1. Enforced here so a client cannot
    // store a percentage, a litre count or a negative reading in a field the
    // engine will read back as a fraction. The 0..1 window sits well inside
    // isNumber's ±1e10 bound, so that predicate is not needed here.
    function levelOk(value) {
      return value == null
        || (value is number && !math.isNaN(value) && value >= 0 && value <= 1);
    }

    function levelSourceOk(value) {
      return value == null
        || value in ['direct-gauge', 'user-correction',
                     'derived-from-full-and-liters', 'derived-after-partial',
                     'imported-legacy', 'unknown'];
    }

    function optionalLevel(data, field) {
      return levelOk(data.get(field, null));
    }

    function optionalLevelSource(data, field) {
      return levelSourceOk(data.get(field, null));
    }

    // The optional tank-state block. Every field may be absent — absence is a
    // missing observation, which is a valid and common state.
    function validTankFields(data) {
      return (data.get('fillEndState', null) == null
              || data.fillEndState in ['full', 'partial', 'unknown'])
        && (data.get('fillEndStateSource', null) == null
            || data.fillEndStateSource in ['user-confirmed', 'gauge-estimate',
                                           'inferred', 'legacy-assumption', 'unknown'])
        && levelOk(data.get('preFillLevel', null))
        && levelOk(data.get('postFillLevel', null))
        && levelSourceOk(data.get('preFillLevelSource', null))
        && levelSourceOk(data.get('postFillLevelSource', null))
        && levelOk(data.get('preFillLevelUncertainty', null))
        && levelOk(data.get('postFillLevelUncertainty', null))
        && (data.get('refuelReason', null) == null
            || data.refuelReason in ['routine', 'low-fuel', 'before-trip',
                                     'good-price', 'unsure'])
        && capacityOk(data.get('capacityLitersAtEntry', null))
        && tankSchemaVersionOk(data.get('tankSchemaVersion', null));
    }

    // 0 < capacity <= 500 lies inside isNumber's bound; NaN stays explicit.
    function capacityOk(value) {
      return value == null
        || (isNonNaNNumber(value) && value > 0 && value <= 500);
    }

    // Same domain as `isNumber(x) && x >= 1`: the upper bound is isNumber's
    // own ceiling, so Infinity is still rejected.
    function tankSchemaVersionOk(value) {
      return value == null
        || (isNonNaNNumber(value) && value >= 1 && value < 9999999999);
    }

    /**
     * A standalone gauge / odometer reading. Owner-only in both directions.
     *
     * `confirmed` distinguishes something the user actually stated from a
     * suggestion they merely accepted, and the model refuses to learn from the
     * latter — so it is a bool the rules insist on rather than an optional hint.
     */
    function validObservation(data) {
      return data.keys().hasOnly([
             'observedAt', 'recordedAt', 'kind', 'odometer', 'level',
             'levelUncertainty', 'levelSource', 'confirmed', 'fillupId',
             'phase', 'schemaVersion'
           ])
        && data.observedAt is timestamp
        && data.kind in ['odometer', 'level', 'both']
        && data.confirmed is bool
        && (!('odometer' in data) || data.odometer == null
            || (isNumber(data.odometer) && data.odometer > 0 && data.odometer < 3000000))
        && optionalLevel(data, 'level')
        && optionalLevel(data, 'levelUncertainty')
        && optionalLevelSource(data, 'levelSource')
        && optionalString(data, 'fillupId', 64)
        && (!('phase' in data) || data.phase == null
            || data.phase in ['before_refuel', 'after_refuel', 'standalone'])
        && optionalNumber(data, 'schemaVersion');
    }

    /**
     * A planned journey. It only ever moves a local forecast, so it is bounded
     * for sanity rather than for correctness — nothing here is authoritative
     * about anything.
     */
    function validTankPlan(data) {
      return data.keys().hasOnly([
             'date', 'distanceKm', 'mode', 'bufferKm', 'note', 'createdAt'
           ])
        && data.date is timestamp
        && isNumber(data.distanceKm) && data.distanceKm > 0 && data.distanceKm <= 20000
        && data.mode in ['additional', 'replaces']
        && (!('bufferKm' in data) || data.bufferKm == null
            || (isNumber(data.bufferKm) && data.bufferKm >= 0 && data.bufferKm <= 20000))
        && optionalString(data, 'note', 200);
    }

    // Optional licensing metadata. Existing unknown fields remain forward
    // compatible; only newly supplied or changed known leaves are validated.
    // Unchanged legacy malformed values must not block an unrelated edit.
    function vehicleDocumentDay(value) {
      return value == null || (value is string && value.matches('^((19|20|21)[0-9]{2}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|((19|20|21)(0[48]|[2468][048]|[13579][26])|2000)-02-29)$'));
    }
    function vehicleDocumentCost(value) {
      return value == null || (value is number && value >= 0 && value <= 1000000);
    }
    function vehicleDocumentCoverage(value) {
      return value in [null, 'comprehensive', 'third', 'none'];
    }
    function validVehicleDocumentRow(before, after, insurance, coverage) {
      let changed = after == null ? [] : after.diff(before is map ? before : {}).affectedKeys();
      // A row is null or a map. Validate changed known leaves once. Unchanged
      // malformed values are retained by exact presence/type/value comparison,
      // without a fallback that re-evaluates the valid leaves of a
      // maximum-size legacy vehicle. Membership tests (`in`) on the
      // changed-key set are the cheapest form under the expression budget.
      return after == null || (after is map
        && (!('due' in changed) || vehicleDocumentDay(after.get('due', null)))
        && (!('cost' in changed) || vehicleDocumentCost(after.get('cost', null)))
        && (!insurance || !('insurer' in changed) || stringOrNull(after.get('insurer', null), 160))
        && (!coverage || !('type' in changed) || vehicleDocumentCoverage(after.get('type', null))));
    }
    function validVehicleDocumentMap(before, after) {
      let previous = before is map ? before : {};
      let changed = after.diff(previous).affectedKeys();
      return (!('test' in changed) || validVehicleDocumentRow(previous.get('test', null), after.get('test', null), false, false))
        && (!('mandatory' in changed) || validVehicleDocumentRow(previous.get('mandatory', null), after.get('mandatory', null), true, false))
        && (!('coverage' in changed) || validVehicleDocumentRow(previous.get('coverage', null), after.get('coverage', null), true, true));
    }
    function validVehicleWrite(before, after) {
      let keys = after.diff(before).affectedKeys();
      let next = after.get('docs', null);
      // When docs do not change, retain the original irreversible deletion
      // latch. Changing docs requires two writable images, which also implies
      // that latch and avoids evaluating it a second time.
      // Keep the common vehicle and document checks in one call frame: the
      // optional test-cost leaf must also fit the 1,000-expression limit.
      // Design v3 fields (biz, EV) are a separate conjunct that applies to
      // every branch, including a patch that also changes docs. They are
      // validated only when one of them is written, so existing vehicles pay
      // nothing for them. The affected-key set is computed once (let).
      return validVehicle(after)
        && (!keys.hasAny(['biz', 'powertrain', 'battery', 'motorKw']) || validVehicleV3(after))
        && (!keys.hasAny(['docs']) ? (
          !before.get('deletionPending', false) || after.get('deletionPending', false) == true
        ) : (
          before.get('deletionPending', false) == false
          && after.get('deletionPending', false) == false
          && (next == null || (next is map && validVehicleDocumentMap(before.get('docs', null), next)))
        ));
    }

    // Pass each optional value once, as validFillup already does. Repeating
    // document lookups makes a fully populated vehicle plus docs exceed the
    // 1,000-expression budget. The emulator regression cases prove that a
    // numeric type plus both finite bounds rejects NaN and either infinity;
    // retain both bounds instead of nesting the shared NaN predicate.
    // Scalar optional values are bound once with `let` and checked inline in
    // validVehicle: every call frame saved is budget for the Design v3
    // fields, which are validated beside the document branch.
    function vehicleDiscountOrNull(value) {
      return value == null || (value is map
        && value.keys().hasOnly(['kind', 'value'])
        && value.kind in ['amount', 'percent']
        && value.value is number && value.value >= 0
        && value.value <= (value.kind == 'percent' ? 100 : 20));
    }
    function validVehicle(data) {
      let tank = data.get('tankLiters', null);
      let declared = data.get('declaredKmPerLiter', null);
      let manual = data.get('manualPricePerLiter', null);
      let year = data.get('year', null);
      let tozeret = data.get('tozeretCd', null);
      let degem = data.get('degemCd', null);
      let prefs = data.get('tankPrefs', null);
      return data.make is string && data.make.size() > 0 && data.make.size() <= 60
        && data.model is string && data.model.size() <= 80
        && data.fuelType in ['95', '98', 'diesel', 'other']
        && data.archived is bool && data.get('deletionPending', false) is bool
        && data.priceAdjustment is number && data.priceAdjustment > -9999999999 && data.priceAdjustment < 9999999999
        && vehicleDiscountOrNull(data.get('priceDiscount', null))
        && (tank == null || (tank is number && tank > 0 && tank < 9999999999))
        && data.get('tankLitersSource', null) in [null, 'user', 'trusted', 'estimate', 'legacy']
        && (declared == null || (declared is number && declared > 0 && declared < 9999999999))
        && data.get('declaredSource', null) in [null, 'user', 'exact-year', 'other-year', 'co2-estimate']
        && (manual == null || (manual is number && manual >= 0 && manual < 9999999999))
        && (year == null || (year is number && year >= 1900 && year <= 2100))
        && (tozeret == null || (tozeret is number && tozeret > -9999999999 && tozeret < 9999999999))
        && (degem == null || (degem is number && degem > -9999999999 && degem < 9999999999))
        && stringOrNull(data.get('plateNumber', null), 12)
        && stringOrNull(data.get('nickname', null), 60)
        && (prefs == null || validTankPrefs(prefs));
    }
    // Design v3 vehicle fields, checked only when one of them is written (see
    // validVehicleWrite) so existing vehicles pay no expression budget for them.
    //  - biz: optional business-statement metadata (owner text, business-use
    //    share 0-100); never read by anyone but the owner.
    //  - powertrain / battery / motorKw: EV registry fields. Absent/null =
    //    unknown (treated as a combustion car, exactly as before).
    // Written inline in one frame: a patch that also changes docs evaluates
    // this beside the document branch, inside the 1,000-expression budget.
    function validVehicleV3(data) {
      let biz = data.get('biz', null);
      let battery = data.get('battery', null);
      let motor = data.get('motorKw', null);
      return (biz == null || (biz is map
          && biz.keys().hasOnly(['company', 'driver', 'usagePct'])
          && (biz.get('company', null) == null || (biz.company is string && biz.company.size() <= 120))
          && (biz.get('driver', null) == null || (biz.driver is string && biz.driver.size() <= 80))
          && (biz.get('usagePct', null) == null || (biz.usagePct is number && biz.usagePct >= 0 && biz.usagePct <= 100))))
        && data.get('powertrain', null) in [null, 'ice', 'phev', 'ev']
        && (battery == null || (battery is map
          && battery.keys().hasOnly(['kwh', 'wltp'])
          && (battery.get('kwh', null) == null || (battery.kwh is number && battery.kwh >= 0.1 && battery.kwh <= 500))
          && (battery.get('wltp', null) == null || (battery.wltp is number && battery.wltp >= 1 && battery.wltp <= 2000))))
        && (motor == null || (motor is number && motor >= 1 && motor <= 2000));
    }
    /**
     * Tank preferences.
     *
     * The reserve is a comfort buffer the user chose, not a manufacturer
     * figure, and it is bounded away from both zero and a full tank so a
     * malformed value cannot make the app recommend refuelling at empty or
     * permanently.
     */
    function validTankPrefs(prefs) {
      let override = prefs.get('refuelLevelOverride', null);
      let usual = prefs.get('usualRefuelLevel', null);
      let reset = prefs.get('habitResetAt', null);
      // Bounds written inline (no helper frames) to fit the expression budget.
      return prefs.keys().hasOnly([
             'reserveFraction', 'refuelLevelOverride', 'usualFillStyle',
             'usualRefuelLevel', 'habitResetAt'
           ])
        && prefs.reserveFraction is number && prefs.reserveFraction >= 0.05 && prefs.reserveFraction <= 0.9
        && (override == null || (override is number && override >= 0 && override <= 1))
        && prefs.get('usualFillStyle', null) in [null, 'full', 'partial', 'unknown']
        && (usual == null || (usual is number && usual >= 0 && usual <= 1))
        && (reset == null || (reset is number && reset > 0 && reset < 4102444800000));
    }

    // An anonymous economy summary. Deliberately narrow: anything that could
    // identify a person or a place is rejected outright, so a compromised
    // client cannot turn this collection into a tracking log.
    function validBenchmark(data) {
      return data.keys().hasOnly([
             'vehicleId', 'modelKey', 'fuelType', 'year', 'avgKmPerLiter',
             'segments', 'avgPricePerLiter', 'updatedAt'
           ])
        && (!('vehicleId' in data) || isString(data.vehicleId, 64))
        && data.modelKey is string && data.modelKey.size() <= 80
        && data.fuelType in ['95', '98', 'diesel', 'other']
        && isNumber(data.avgKmPerLiter)
        && data.avgKmPerLiter > 0 && data.avgKmPerLiter < 100
        && isNumber(data.segments) && data.segments >= 0
        && (data.year == null
            || (isNumber(data.year) && data.year >= 1900 && data.year <= 2100))
        && (data.avgPricePerLiter == null
            || (isNumber(data.avgPricePerLiter) && data.avgPricePerLiter >= 0));
    }

    // A previously used financial-sharing account needs a fresh erasure intent.
    // A cached pre-TCO client cannot silently skip the new collection on retry.
    function costDeletionAttempt(before, after) {
      let previous = before.get('settings', {});
      let settings = after.get('settings', {});
      return after.get('deletionPending', false) == true
        && after.get('costDeletionAttemptAt', null) is timestamp
        && after.costDeletionAttemptAt == request.time
        && settings is map && settings.get('shareTcoBenchmarks', true) == false
        && after.diff(before).affectedKeys().hasOnly(['deletionPending', 'costDeletionAttemptAt', 'settings'])
        && settings.diff(previous is map ? previous : {}).affectedKeys().hasOnly(['shareTcoBenchmarks']);
    }

    match /users/{uid} {
      // Admins read the PROFILE only — display name, email, join date — which
      // the dashboard needs to list accounts and support needs to find one.
      // Vehicles and fill-ups below are owner-only, with no admin exception.
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && (accountWritable(uid) || (request.resource.data.deletionPending == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletionPending']))
          || costDeletionAttempt(resource == null ? {} : resource.data, request.resource.data))
        && (resource == null || resource.data.get('costSharingUsed', false) != true || request.resource.data.get('costSharingUsed', false) == true)
        && (resource == null || resource.data.get('costSharingUsed', false) != true || request.resource.data.get('deletionPending', false) != true
          || costDeletionAttempt(resource.data, request.resource.data))
        && request.resource.data.get('deletionPending', false) is bool
        && (!('settings' in request.resource.data) || request.resource.data.settings is map)
        // Login stamps, rotated once per authentication event. Numbers only,
        // so a client cannot stash arbitrary structures on the profile.
        && optionalEpochMillis(request.resource.data, 'previousLoginAt')
        && optionalEpochMillis(request.resource.data, 'currentLoginAt')
        && optionalEpochMillis(request.resource.data, 'lastProcessedAuthTime');
      allow delete: if isOwner(uid) && (resource.data.get('costSharingUsed', false) != true
        || (resource.data.get('deletionPending', false) == true
          && resource.data.get('settings', {}).get('shareTcoBenchmarks', true) == false
          && resource.data.get('costDeletionAttemptAt', null) is timestamp));

      /**
       * Raw community price reports.
       *
       * Owner-only, in both directions. A raw observation is tied to one person
       * and one place at one time, so it never becomes readable by other signed
       * -in users; only the backend-produced aggregate is public.
       */
      match /stationPriceReports/{reportId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && accountWritable(uid) && validPriceReport(request.resource.data);
        // A report is an observation, not a document to revise.
        allow update: if false;
      }

      /**
       * Import batch records.
       *
       * These exist so an import stays reversible: every record an import
       * created carries the batch id, and deleting the batch removes exactly
       * those rows and nothing a person entered by hand.
       */
      /**
       * Explicit personal pricing rules.
       *
       * Private in both directions: a discount someone negotiated is theirs,
       * and it must never leak into a public station price. `legacy` marks a
       * rule carried over from the pre-upgrade vehicle fields; it does nothing
       * until `reviewed` is true.
       */
      match /personalPriceRules/{ruleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && accountWritable(uid)
          && request.resource.data.keys().hasOnly([
               'vehicleId', 'stationId', 'stationName', 'fuelType',
               'discountPerLiter', 'fixedPricePerLiter', 'label',
               'expiresAt', 'legacy', 'reviewed', 'migratedAt'
             ])
          && optionalString(request.resource.data, 'vehicleId', 64)
          && optionalString(request.resource.data, 'stationId', 64)
          && optionalString(request.resource.data, 'stationName', 120)
          && optionalString(request.resource.data, 'label', 80)
          && (!('fuelType' in request.resource.data)
              || request.resource.data.fuelType == null
              || request.resource.data.fuelType in ['95', '98', 'diesel', 'other'])
          && isNumber(request.resource.data.discountPerLiter)
          && request.resource.data.discountPerLiter > -50
          && request.resource.data.discountPerLiter < 50
          && (!('fixedPricePerLiter' in request.resource.data)
              || request.resource.data.fixedPricePerLiter == null
              || (isNumber(request.resource.data.fixedPricePerLiter)
                  && request.resource.data.fixedPricePerLiter >= 0
                  && request.resource.data.fixedPricePerLiter < 100))
          && optionalEpochMillis(request.resource.data, 'expiresAt')
          && optionalBool(request.resource.data, 'legacy')
          && optionalBool(request.resource.data, 'reviewed');
      }

      match /importBatches/{batchId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && accountWritable(uid)
          && request.resource.data.keys().hasOnly([
               'vehicleId', 'format', 'fileName', 'recordCount',
               'vehicleLabel', 'importedAt'
             ])
          && isString(request.resource.data.vehicleId, 64)
          && isString(request.resource.data.format, 40)
          && optionalString(request.resource.data, 'fileName', 200)
          && optionalString(request.resource.data, 'vehicleLabel', 120)
          && isNumber(request.resource.data.recordCount)
          && request.resource.data.recordCount >= 0
          && request.resource.data.recordCount <= 100000;
      }

      /**
       * Vehicles and fill-ups are OWNER-ONLY.
       *
       * Admins used to have read here, for a dashboard that counted records by
       * reading them. It now reads published summaries instead, so the
       * permission had no remaining purpose — and a permission with no purpose
       * is one that should not exist.
       */
      match /vehicles/{vehicleId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid) && !existsAfter(/databases/$(database)/documents/costBenchmarks/$(uid + '__' + vehicleId));
        allow create, update: if isOwner(uid) && accountWritable(uid)
          && validVehicleWrite(resource == null ? {} : resource.data, request.resource.data);

        match /fillups/{fillupId} {
          allow read: if isOwner(uid);
          allow delete: if isOwner(uid);
          allow create: if isOwner(uid) && accountWritable(uid) && validFillup(request.resource.data)
            && (request.resource.data.get('importSource','') != 'receipt-text-v1' || careVehicleWritable(uid, vehicleId))
            && versionOk(request.resource.data);
          // Optimistic concurrency: a client that stamps `version` must be
          // writing over the document it read, so the new stamp has to be
          // exactly stored + 1 (a legacy document with no stamp counts as 0).
          // A patch that omits the field is a pre-version client and is let
          // through — note that updateDoc merges the stored fields into
          // request.resource.data, so on a versioned document that patch
          // DOES carry the stored version, and stored == stored + 1 fails.
          // Kept off the create line: `resource` is null there.
          // Mixed client versions during the rollout:
          //  - a version-aware client stamps a fresh `writeId` on every write,
          //    so its write CHANGES that field; it must then carry exactly
          //    stored + 1 (a one-step-stale edit sends a value equal to the
          //    stored one and is refused, which a bare "unchanged version"
          //    relaxation would wrongly accept);
          //  - a pre-version client never touches `writeId`. Its updateDoc
          //    merges the stored `version` back in unchanged, and its setDoc
          //    carries neither field: both are let through as they were
          //    before versions existed (legacy last-write-wins remains).
          // Modern clients compare editable state in a server transaction:
          // version/writeId alone cannot detect an intervening legacy patch.
          // These compatible rules cannot protect older unconditional clients;
          // preserve their queued inputs and upgrade before editing conflicts.
          allow update: if isOwner(uid) && accountWritable(uid) && validFillup(request.resource.data)
            && (request.resource.data.get('importSource','') != 'receipt-text-v1' || careVehicleWritable(uid, vehicleId))
            && ((('writeId' in request.resource.data)
                 && request.resource.data.diff(resource.data).affectedKeys().hasAny(['writeId']))
                  ? request.resource.data.version == resource.data.get('version', 0) + 1
                  : (!('version' in request.resource.data)
                     || (request.resource.data.version == resource.data.get('version', 0)
                         && request.resource.data.version >= 1)));
        }

        /**
         * Tank observations and planned trips.
         *
         * Owner-only, exactly like fill-ups. A tank state, a refuelling habit
         * and a future journey are among the most revealing things the app
         * holds — where somebody will be and when — so none of it is readable
         * by other users, by the community aggregates or by an admin.
         */
        match /serviceEvents/{recordId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && accountWritable(uid) && careVehicleWritable(uid, vehicleId) && validService(request.resource.data) && request.resource.data.version == 1;
          allow update: if isOwner(uid) && accountWritable(uid) && careVehicleWritable(uid, vehicleId) && validService(request.resource.data) && request.resource.data.version == resource.data.version + 1;
        }

        match /maintenancePlans/{recordId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && accountWritable(uid) && careVehicleWritable(uid, vehicleId) && validCarePlan(request.resource.data) && request.resource.data.version == 1;
          allow update: if isOwner(uid) && accountWritable(uid) && careVehicleWritable(uid, vehicleId) && validCarePlan(request.resource.data) && request.resource.data.version == resource.data.version + 1;
        }

        match /vehicleExpenses/{recordId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && accountWritable(uid) && careVehicleWritable(uid, vehicleId) && validCareExpense(request.resource.data) && request.resource.data.version == 1;
          allow update: if isOwner(uid) && accountWritable(uid) && careVehicleWritable(uid, vehicleId) && validCareExpense(request.resource.data) && request.resource.data.version == resource.data.version + 1;
        }

        match /odometerReadings/{recordId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && accountWritable(uid) && careVehicleWritable(uid, vehicleId) && validMileage(request.resource.data) && request.resource.data.version == 1;
          allow update: if isOwner(uid) && accountWritable(uid) && careVehicleWritable(uid, vehicleId) && validMileage(request.resource.data) && request.resource.data.version == resource.data.version + 1;
        }

        match /vehicleIssues/{recordId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && accountWritable(uid) && careVehicleWritable(uid, vehicleId) && validVehicleIssue(request.resource.data) && request.resource.data.version == 1;
          allow update: if isOwner(uid) && accountWritable(uid) && careVehicleWritable(uid, vehicleId) && validVehicleIssue(request.resource.data) && request.resource.data.version == resource.data.version + 1;
        }

        match /notificationStates/{recordId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && accountWritable(uid) && careVehicleWritable(uid, vehicleId) && validNotificationState(request.resource.data) && request.resource.data.version == 1;
          allow update: if isOwner(uid) && accountWritable(uid) && careVehicleWritable(uid, vehicleId) && validNotificationState(request.resource.data) && request.resource.data.version == resource.data.version + 1;
        }

        match /observations/{observationId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && accountWritable(uid) && validObservation(request.resource.data);
        }

        match /tankPlans/{planId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && accountWritable(uid) && validTankPlan(request.resource.data);
        }
      }
    }

    /**
     * A price observation. Plausibility is bounded per fuel type: a report far
     * outside the range that fuel has ever traded at in Israel is a typo or an
     * attack, and either way must not reach the aggregate.
     */
    function validPriceReport(data) {
      return data.keys().hasOnly([
             'stationId', 'fuelType', 'serviceMode', 'postedPrice', 'paidPrice',
             'hadPersonalDiscount', 'observedAt', 'createdAt',
             'locationConfidence', 'reportSource', 'appVersion', 'status'
           ])
        && isString(data.stationId, 64) && data.stationId.size() > 0
        && data.fuelType in ['95', '98', 'diesel', 'other']
        && (!('serviceMode' in data) || data.serviceMode in ['self', 'full'])
        && isNumber(data.postedPrice)
        && data.postedPrice > 1 && data.postedPrice < 30
        && (!('paidPrice' in data) || data.paidPrice == null
            || (isNumber(data.paidPrice) && data.paidPrice > 0 && data.paidPrice < 30))
        && optionalBool(data, 'hadPersonalDiscount')
        && data.observedAt is timestamp
        && (!('locationConfidence' in data)
            || data.locationConfidence in ['verified', 'nearby', 'manual'])
        && optionalString(data, 'reportSource', 40)
        && optionalString(data, 'appVersion', 20)
        && (!('status' in data) || data.status in ['pending', 'accepted', 'rejected']);
    }

    /**
     * Operational summaries, published by each client for the admin dashboard.
     *
     * Counts and averages only: no dates beyond the last fill-up, no odometer
     * readings, no stations, no notes, no per-record prices. This is what lets
     * the dashboard stop reading anybody's fuel log.
     *
     * They are CLIENT-PRODUCED and back no security decision — a modified
     * client can write whatever it likes about itself. The bounds below exist
     * so a hostile value cannot break the dashboard, not so the numbers can be
     * trusted for anything that matters.
     */
    function validSummary(data) {
      return data.keys().hasOnly(['version', 'vehicleCount', 'vehicles', 'updatedAt'])
        && isNumber(data.version)
        && isNumber(data.vehicleCount)
        && data.vehicleCount >= 0 && data.vehicleCount <= 100
        && data.vehicles is map
        && data.vehicles.keys().size() <= 100;
    }

    match /userSummaries/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && accountWritable(uid) && validSummary(request.resource.data);
      allow delete: if isOwner(uid) || isAdmin();
    }

    /**
     * Public station-price aggregates.
     *
     * Readable by any signed-in user, writable ONLY by trusted backend code,
     * which bypasses rules. A client therefore cannot forge a confidence level,
     * a report count or a reporter total to make a fabricated price look
     * corroborated. Until the aggregator is deployed (Blaze), this collection
     * is simply empty and the UI says the data is unavailable.
     */
    match /stationPriceAggregates/{aggregateId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /**
     * Community benchmarks, one document PER VEHICLE.
     *
     * The id is "{uid}__{vehicleId}", so ownership is provable without a
     * backend while a two-car household no longer has one vehicle overwrite
     * the other. The bare "{uid}" form is still accepted so pre-upgrade
     * documents remain writable and deletable by their owner.
     *
     * Note that the uid appears in a world-readable document id. That makes
     * this pool PSEUDONYMOUS, not anonymous, and the documentation says so.
     * True anonymity requires the Blaze-side cohort aggregator.
     */
    function ownsBenchmark(docId) {
      return isSignedIn()
        && (docId == request.auth.uid || docId.matches(request.auth.uid + '__.*'));
    }

    match /benchmarks/{docId} {
      allow read: if isSignedIn();
      allow create, update: if ownsBenchmark(docId) && accountWritable(request.auth.uid)
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('settings', {}).get('shareBenchmarks', true) != false)
        && validBenchmark(request.resource.data);
      allow delete: if ownsBenchmark(docId) || isAdmin();
    }

    // Explicit opt-in ownership-cost summary. No receipt/component/person/place fields.
    function validCostBenchmark(data) {
      return data.keys().hasOnly(['vehicleId', 'modelKey', 'fuelType', 'monthlyCost', 'months', 'method', 'updatedAt'])
        && data.keys().hasAll(['vehicleId', 'modelKey', 'fuelType', 'monthlyCost', 'months', 'method', 'updatedAt'])
        && isString(data.vehicleId, 64) && data.vehicleId.size() > 0
        && isString(data.modelKey, 80) && data.modelKey.size() > 0
        && data.fuelType in ['95', '98', 'diesel', 'other']
        && isNumber(data.monthlyCost) && data.monthlyCost > 0 && data.monthlyCost <= 1000000
        && data.months is int && data.months >= 1 && data.months <= 12
        && data.method == 1 && data.updatedAt is timestamp && data.updatedAt == request.time;
    }
    function costSharingAllowed(vehicleId, fuelType) {
      let profile = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let vehicle = get(/databases/$(database)/documents/users/$(request.auth.uid)/vehicles/$(vehicleId)).data;
      return profile.get('deletionPending', false) == false
        && profile.get('costSharingUsed', false) == true
        && profile.get('settings', {}).get('shareTcoBenchmarks', false) == true
        && vehicle.get('archived', false) == false && vehicle.get('deletionPending', false) == false
        && vehicle.fuelType == fuelType;
    }
    match /costBenchmarks/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && validCostBenchmark(request.resource.data)
        && docId == request.auth.uid + '__' + request.resource.data.vehicleId
        && costSharingAllowed(request.resource.data.vehicleId, request.resource.data.fuelType);
      // Missing rows need no mutation; owned orphan rows remain erasable after vehicle removal.
      allow delete: if isSignedIn() && (!exists(/databases/$(database)/documents/costBenchmarks/$(docId))
        || docId == request.auth.uid + '__' + resource.data.vehicleId);
    }

    // Product feedback. A user may file and read back their own notes; only
    // admins can read the whole pile. Nothing here is ever editable after the
    // fact, so a submission cannot be quietly rewritten.
    function validFeedback(data) {
      return data.keys().hasOnly([
             'uid', 'displayName', 'email', 'message', 'sentiment',
             'appVersion', 'screen', 'createdAt'
           ])
        && data.uid == request.auth.uid
        && data.message is string
        && data.message.size() > 0 && data.message.size() <= 2000
        && (!('sentiment' in data) || data.sentiment == null
            || data.sentiment in ['good', 'idea', 'bug'])
        && (!('displayName' in data) || data.displayName == null
            || (data.displayName is string && data.displayName.size() <= 100))
        && (!('email' in data) || data.email == null
            || (data.email is string && data.email.size() <= 200))
        && (!('appVersion' in data) || data.appVersion == null
            || (data.appVersion is string && data.appVersion.size() <= 20))
        && (!('screen' in data) || data.screen == null
            || (data.screen is string && data.screen.size() <= 60));
    }

    match /feedback/{entryId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && accountWritable(request.auth.uid) && validFeedback(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Scan samples: one record per reading attempt (camera session or chosen file), plus the
    // rows the engine cut out, in `scanImages` under the same id. The owner creates them and may
    // attach, once, what was finally saved; nothing else is ever editable. Admins read them to
    // measure the reader; scripts/scan-learn (Admin SDK) re-tunes its thresholds from them.
    function scanKey(value) { return value == null || (value is string && value.size() <= 40 && value.matches('^[0-9.|]+$')); }
    function validScanSample(d) {
      return d.keys().hasOnly(['uid','createdAt','day','appVersion','engine','kind','source','session','attempt','outcome','guess',
                               'confidence','ms','frames','seconds','width','height','journal','platform','final','result','labeledAt'])
        && d.uid == request.auth.uid
        && d.createdAt is number && d.createdAt > 1700000000000 && d.createdAt < 4102444800000
        && careDay(d.day) && isString(d.appVersion, 20) && careInt(d.engine, 100000)
        && d.kind in ['pump','odometer'] && d.source in ['camera','file']
        && isString(d.session, 64) && d.session.size() > 0 && d.attempt is int && d.attempt >= 1 && d.attempt <= 99
        && d.outcome in ['read','unreadable'] && scanKey(d.guess)
        && (d.confidence == null || (isNonNaNNumber(d.confidence) && d.confidence >= 0 && d.confidence <= 1))
        && careInt(d.ms, 600000) && careInt(d.frames, 100000)
        && isNonNaNNumber(d.seconds) && d.seconds >= 0 && d.seconds <= 3600
        && careInt(d.width, 20000) && careInt(d.height, 20000)
        && d.journal is bool && d.platform in ['android','ios','other']
        && d.final == null && d.result == null && d.labeledAt == null;
    }
    function validScanPicture(p) {
      return p is map && p.keys().hasOnly(['role','text','confidence','w','h','jpeg'])
        && careInt(p.w, 2000) && careInt(p.h, 2000) && p.jpeg is string && p.jpeg.size() > 0 && p.jpeg.size() <= 60000
        && (!('role' in p) || p.role in ['odometer','total','liters','price'])
        && (!('text' in p) || isString(p.text, 16))
        && (!('confidence' in p) || (isNonNaNNumber(p.confidence) && p.confidence >= 0 && p.confidence <= 1));
    }
    function scanStripAt(strips, n) { return strips.size() <= n || validScanPicture(strips[n]); }
    function validScanImages(d) {
      return d.keys().hasOnly(['uid','createdAt','strips','thumb'])
        && d.uid == request.auth.uid && d.createdAt is number
        && d.strips is list && d.strips.size() <= 3
        && scanStripAt(d.strips, 0) && scanStripAt(d.strips, 1) && scanStripAt(d.strips, 2)
        && (d.thumb == null || validScanPicture(d.thumb));
    }

    match /scanSamples/{sampleId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && accountWritable(request.auth.uid) && validScanSample(request.resource.data);
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid && resource.data.final == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['final','result','labeledAt'])
        && request.resource.data.final is string && scanKey(request.resource.data.final)
        && request.resource.data.result in ['match','corrected','manual']
        && request.resource.data.labeledAt is number;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }
    match /scanImages/{sampleId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && accountWritable(request.auth.uid) && validScanImages(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Global config: readable by any signed-in user; written by the scheduled
    // function, the admin seed script (both bypass rules), or a signed-in admin.
    match /appConfig/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
