# Firebase web-app client config (public by design — safe to ship in the bundle).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "1" to point the app at the local emulator suite.
VITE_USE_EMULATORS=

# ---------------------------------------------------------------------------
# Capability flags.
#
# Every flag below gates a feature that needs infrastructure this project does
# NOT currently run. The default (unset) is the honest Spark behaviour: the UI
# shows a real empty state rather than a fabricated result.
# ---------------------------------------------------------------------------

# "1" routes vehicle lookup through /api/vehicle-lookup when the direct call to
# data.gov.il fails. Requires the vehicleLookup Function to be DEPLOYED and a
# Hosting rewrite placed BEFORE the SPA catch-all — otherwise the route returns
# index.html. Blaze only. Leave unset on Spark.
VITE_VEHICLE_LOOKUP_PROXY=

# "1" enables community station-price reporting and the public aggregates it
# feeds. Requires the backend aggregator, App Check and rate limiting. Blaze
# only. While unset, station prices fall back to the regulated maximum for the
# fuel types it covers, and to "unknown" for the rest.
VITE_STATION_PRICE_COMMUNITY_ENABLED=

# "1" tells the UI that the regulated price is maintained by the scheduled
# updater. Requires that Function to be deployed. While unset, the UI says the
# price was entered manually, which is what actually happens on Spark.
VITE_FUEL_PRICE_AUTOMATION_ENABLED=

# Optional external station-price provider. Leave EMPTY unless billing,
# the provider's caching/storage terms and the privacy disclosure have all been
# reviewed — enabling it sends station coordinates off-device.
VITE_STATION_PRICE_PROVIDER=
VITE_STATION_PRICE_PROVIDER_KEY=
